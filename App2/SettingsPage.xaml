<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App2.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Storyboard x:Name="SyncSpin">
            <DoubleAnimation
                Storyboard.TargetName="SyncSpinner"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="0"
                To="360"
                Duration="0:0:1"
                RepeatBehavior="Forever"/>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="8" Padding="24">

                <!-- SYNC -->

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Sync" FontWeight="SemiBold"/>
                            <TextBlock
                                x:Name="LastCheckedTextBlock"
                                Text="Last checked: Never"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Button
                            x:Name="butt"
                            Grid.Column="1"
                            Width="45"
                            Height="45"
                            Click="SyncButton_Click">

                            <Grid
                                x:Name="SyncSpinner"
                                RenderTransformOrigin="0.5,0.5">

                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>

                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Glyph="&#xEDAB;"
                                    FontSize="20"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- Notification-->

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Notifications" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Show sync notifications"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ComboBox
                            x:Name="NotificationsComboBox"
                            Grid.Column="1"
                            Width="140"
                            SelectionChanged="NotificationsComboBox_SelectionChanged">

                            <ComboBoxItem Content="Enabled"/>
                            <ComboBoxItem Content="Disabled"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- backdrop -->

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Backdrop" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Choose the window backdrop"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ComboBox
                            x:Name="BackdropComboBox"
                            Grid.Column="1"
                            Width="140"
                            SelectionChanged="BackdropComboBox_SelectionChanged">

                            <ComboBoxItem Content="Mica"/>
                            <ComboBoxItem Content="Acrylic"/>
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

